{
  "name": "tsdice",
  "version": "1.0.0",
  "description": "tsDice - The Ultimate tsParticles Scene Randomizer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:docs": "node scripts/build-docs.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "badges:update": "node scripts/update-badges.js",
    "lint": "eslint js/ tests/ --ext .js",
    "lint:fix": "eslint js/ tests/ --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "all": "npm ci && npm run all:quick",
    "all:quick": "npm run build:docs && npm run build && npm run lint:fix && npm run format && npm run test"
  },
  "keywords": [
    "tsparticles",
    "particles",
    "animation",
    "randomizer"
  ],
  "author": "zophiezlan",
  "license": "MIT",
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-legacy": "^8.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "vite-plugin-html": "^3.2.2",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "marked": "^18.0.7",
    "prettier": "^3.9.6",
    "vite": "^8.2.0"
  },
  "allowScripts": {
    "core-js@3.50.0": true
  }
}
